# Non-secret settings. Do not place real passwords or API tokens here.
POSTGRES_DB=hunter_harness
POSTGRES_USER=hunter_harness
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
BOOTSTRAP_TOKEN_FILE=./secrets/bootstrap_token.txt
HUNTER_HARNESS_NPM_SCOPE=@hunter-harness
NPM_TOKEN_FILE=./secrets/npm_token.txt
HUNTER_HARNESS_BOOTSTRAP_ACTOR=actor_owner
HUNTER_HARNESS_BOOTSTRAP_NAME=Owner
WEB_PORT=3000

# Local (non-compose) server
# DATABASE_URL=postgresql://hunter_harness:change-me@127.0.0.1:5432/hunter_harness
# ARTIFACT_ROOT=./.local/artifacts
# PORT=3001
# HOST=127.0.0.1

# Local Next.js → API rewrite (optional)
# HUNTER_HARNESS_INTERNAL_API_URL=http://127.0.0.1:3001
# NEXT_PUBLIC_HUNTER_HARNESS_API_URL=

# Platform information views（分支文件 / 项目资料 / 项目知识 / 变更记录）的游标签名密钥。
# 未设置的视图会 fail closed 返回 PLATFORM_INFORMATION_UNAVAILABLE（"… adapter is not configured"）。
# 每个密钥要求 ≥16 个不重复字节，建议 `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` 生成，或用 *_FILE 变体指向 secrets 文件。
# HUNTER_BRANCH_MONITOR_CURSOR_SECRET=
# HUNTER_PROJECT_MATERIALS_CURSOR_SECRET=
# HUNTER_PROJECT_KNOWLEDGE_CURSOR_SECRET=
# HUNTER_CHANGE_RECORDS_CURSOR_SECRET=
# 注意：即使配好密钥，在数据源（branch snapshot 写入 Push/Finalize、Stage 06 知识/变更真相源）接入前，页面会按设计诚实显示 processing/空态——这是 roadmap 阶段 13 明确"仍未接入"的部分。
