# Contract fixtures are compared byte-for-byte against their canonical
# serialization (`JSON.stringify(fixture) + "\n"`). Under core.autocrlf a
# Windows checkout rewrites them to CRLF and that comparison can never hold,
# so pin the whole directory rather than one file at a time.
packages/contracts/test/fixtures/** text eol=lf
