apps/server/openapi/hunter-harness-v1.yaml text eol=lf
apps/server/openapi/hunter-harness-v1.yaml.sha256 text eol=lf
packages/contracts/src/content-sync.ts text eol=lf
packages/contracts/test/fixtures/content-sync-v0-legacy.json text eol=lf
